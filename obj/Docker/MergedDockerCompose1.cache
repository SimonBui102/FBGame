name: dockercompose3508350822067479840
services:
  database.server:
    container_name: database.server
    environment:
      ACEEPT_EULA: "y"
      SA_PASSWORD: SuperPassword123
    healthcheck:
      test:
        - CMD-SHELL
        - /opt/mssql-tools/bin/sqlcmd -S localhost -U SA -P "SuperPassword123" -Q "SELECT 1" -b -o /dev/null
      timeout: 3s
      interval: 10s
      retries: 10
      start_period: 10s
    image: mcr.microsoft.com/mssql/server
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    volumes:
      - type: bind
        source: E:\Job\Soft_dev\JRM\FZGame\Game\sqlserver\data
        target: /var/opt/mssql/data
        bind:
          create_host_path: true
      - type: bind
        source: E:\Job\Soft_dev\JRM\FZGame\Game\sqlserver\log
        target: /var/opt/mssql/log
        bind:
          create_host_path: true
  games.api:
    build:
      context: E:\Job\Soft_dev\JRM\FZGame\Game
      dockerfile: Games.Presentation/Dockerfile
    container_name: games.api
    depends_on:
      database.server:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "3000"
      ASPNETCORE_HTTPS_PORTS: "3001"
      ASPNETCORE_Kestrel__Certificates__Default__Password: "123"
      ASPNETCORE_Kestrel__Certificates__Default__Path: /https/games.pfx
    image: games.api
    networks:
      default: null
    ports:
      - mode: ingress
        target: 3000
        published: "3000"
        protocol: tcp
      - mode: ingress
        target: 3001
        published: "3001"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Admin\.aspnet\https
        target: /https
        read_only: true
        bind:
          create_host_path: true
  games.client:
    build:
      context: E:\Job\Soft_dev\JRM\FZGame\Game\Games.Presentation\Client\games
      dockerfile: Dockerfile
    container_name: games.client
    depends_on:
      games.api:
        condition: service_started
        required: true
    image: games.client
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
networks:
  default:
    name: dockercompose3508350822067479840_default